# ---- Tavily (web search) -------------------------------------------------
# https://app.tavily.com  ->  API Keys
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Nebius Token Factory (inference) ------------------------------------
# https://tokenfactory.nebius.com  ->  API Keys
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Leave NEBIUS_MODEL blank to auto-pick the first chat model on your account
NEBIUS_MODEL=
NEBIUS_EMBEDDING_MODEL=BAAI/bge-en-icl

# ---- Nebius AI Cloud Object Storage (optional briefing archive) ----------
# https://console.nebius.com  ->  Object Storage. Leave blank to disable.
NEBIUS_STORAGE_BUCKET=
NEBIUS_STORAGE_REGION=eu-north1
NEBIUS_STORAGE_ENDPOINT=https://storage.eu-north1.nebius.cloud
NEBIUS_STORAGE_ACCESS_KEY_ID=
NEBIUS_STORAGE_SECRET_ACCESS_KEY=

# ---- App -----------------------------------------------------------------
PORT=8000
